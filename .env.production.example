# NUVORA — production environment template (G4 surface).
# Copy to .env.production (gitignored) and fill every value.
# The API REFUSES to start in production with missing/weak critical values
# (config.Validate) — leave nothing below at a placeholder in production.

# ── Core ───────────────────────────────────────────────────────────────────
ENVIRONMENT=production
PORT=8080
SITE_URL=https://nuvora.com
ALLOWED_ORIGINS=https://nuvora.com
# COOKIE_DOMAIN — shared parent domain for the session cookie so it reaches the
# web origin through the proxy when the frontend and API are on different hosts
# (Vercel + Render). Example: ".vercel.app" or "nuvora.com". Empty = host-only.
COOKIE_DOMAIN=

# ── Data ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://nuvora:CHANGE_ME@postgres:5432/nuvora?sslmode=disable
REDIS_URL=redis://redis:6379/0

# ── Payments (G4.1 — staging first: test keys, then live) ──────────────────
PAYMENT_PROVIDER=PAYSTACK
PAYSTACK_SECRET=sk_test_...
FLUTTERWAVE_SECRET=FLW_SECRET_TEST_...
# One-click tutor payouts via Paystack Transfers. Requires the Paystack
# balance to be funded; transfers fail closed unless a real PAYSTACK_SECRET
# is set. Tutors must select their bank (code) in the Earnings tab.
PAYSTACK_TRANSFER_ENABLED=false

# ── Email (G4.2) ───────────────────────────────────────────────────────────
# Recommended: Resend REST API — one key from https://resend.com, no SMTP
# relay allowlisting. When RESEND_API_KEY is set it takes precedence over SMTP.
RESEND_API_KEY=CHANGE_ME
# …or classic SMTP:
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
EMAIL_FROM=no-reply@nuvora.com

# ── SMS / WhatsApp (G4.2 — Termii) ─────────────────────────────────────────
TERMII_API_KEY=CHANGE_ME
TERMII_SENDER_ID=Nuvora
# TERMII_WHATSAPP_SENDER=2348XXXXXXX  # Termii-issued WhatsApp sender number
# TERMII_FROM=2348XXXXXXX   # optional override (sender id or shortcode)
# WHATSAPP_BUSINESS_NUMBER=2348XXXXXXX # shown on the site for live-chat links

# ── Object storage (G4.2 — S3-compatible) ──────────────────────────────────
S3_ENDPOINT=s3.eu-west-1.amazonaws.com
S3_REGION=eu-west-1
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_PUBLIC_BUCKET=nuvora-public
S3_PRIVATE_BUCKET=nuvora-private
S3_QUARANTINE_BUCKET=nuvora-quarantine
STORAGE_MAX_UPLOAD_BYTES=10485760
# STORAGE_ALLOWED_MIME=application/pdf,image/jpeg,image/png
# ClamAV daemon (docker-compose.prod.yml ships one): uploads fail closed when
# the scanner is unreachable, so point this at the clamav service.
CLAMAV_ADDR=clamav:3310

# ── Video meetings (G4.2) ──────────────────────────────────────────────────
MEETING_PROVIDER=whereby      # "stub" without credentials
WHEREBY_API_KEY=CHANGE_ME

# ── OAuth (G4.3) ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URL=https://nuvora.com/auth/google/callback

# Auth test aid (SECURITY-SENSITIVE)
# AUTH_LOG_CODES=true prints plain-text login codes + password-reset links
# to the logs, even in production. Use ONLY to smoke-test email flows
# before SMTP is configured - anyone with log access can read them.
# Leave unset/false for any environment with real users.
# AUTH_LOG_CODES=false

# ── AI assistant (G4.3 — caps + fallback) ──────────────────────────────────
CHATBOT_ENABLED=true
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-2.0-flash
AI_MAX_TOKENS_PER_REQUEST=1024
AI_DAILY_BUDGET_TOKENS=200000

# ── Mobile push (G4.3 — Expo) ──────────────────────────────────────────────
EXPO_ACCESS_TOKEN=CHANGE_ME

# ── Observability (G3) ─────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=            # e.g. https://tempo.example.com
METRICS_TOKEN=CHANGE_ME                 # bearer required to scrape /metrics
# LOG_LEVEL=info                        # debug|info|warn|error (default info).
#                                       # Production logs are structured JSON (log/slog, A-20).

# ── Ops (G3/G4) ────────────────────────────────────────────────────────────
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
BACKUP_METRICS_DIR=/metrics-textfile
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
