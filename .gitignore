# ─── Dependencies / builds ────────────────────────────────────────────────
node_modules/
.next/
out/
dist/
coverage/
*.tsbuildinfo

# Go
*.exe
*.test
*.out
.e2e-api
.staging-api

# Mobile build artifacts (large) — host the APK/AAB in object storage
# (R2/S3/GitHub Releases) and set NEXT_PUBLIC_APK_URL. Never commit builds.
*.apk
*.aab
mobile/dist/
mobile/android/app/build/
mobile/ios/build/

# ─── Secrets & environments ───────────────────────────────────────────────
# Only .env.production.example is tracked. Everything real is local.
.env
.env.*
!.env.production.example

# ─── Local data / ops artifacts ───────────────────────────────────────────
*.log
backups/
metrics-textfile/
/tmp/
.DS_Store
.vscode/
.vercel
.history/

# ─── Local working files — never commit ───────────────────────────────────
# Root-level apply/seed/cleanup scripts from local patch runs.
/APPLY*.ps1
/FIX*.ps1
/SEED*.ps1
/CLEANUP_JUNK.ps1
# Local audit patches and one-off local seeds.
*.patch
audit-round*.patch
seed-quickstart.sql
seed-local-users.once.txt
# Local git-bundle patch artifacts from phased delivery (root level).
*.bundle
