+		where += " AND (u.email ILIKE " + arg("%"+search+"%") + " OR COALESCE(u.first_name,'') ILIKE " + arg("%"+search+"%") + " OR COALESCE(u.last_name,'') ILIKE " + arg("%"+search+"%") + ")"
