-# APK Release — builds the Android APK and publishes it as a downloadable artifact.
-#
-# Runs on:
-#   - a version tag (vX.Y.Z) -> creates/updates a GitHub Release with the APK
-#   - workflow_dispatch        -> builds and uploads the APK to object storage
-#     (Cloudflare R2 / AWS S3) if those secrets are configured
-#
-# Why GitHub Releases for the APK: a 100MB+ APK exceeds Cloudflare's free 25MB
-# asset limit, but GitHub Releases have no practical size limit and serve a
-# stable "latest" download URL for free. R2 objects can exceed 25MB too, but
-# the Cloudflare Pages free 25MB asset cap does NOT apply to R2.
-#
-# After this runs, set the web env var on Vercel/Render:
-#   NEXT_PUBLIC_APK_URL=<release download url>  (or the R2/S3 URL if used)
-
 name: APK Release
 
 on:
@@ -36,7 +21,7 @@ jobs:
 
       - uses: actions/setup-node@v4
         with:
-          node-version: "20"
+          node-version: "22"
           cache: npm
           cache-dependency-path: mobile/package-lock.json
 
@@ -46,13 +31,7 @@ jobs:
       - name: Typecheck
         run: npx tsc --noEmit
 
-      # Build with EAS CLOUD build (not a local gradle build).
-      #
-      # Why: a local `gradlew assembleRelease` produces an UNSIGNED release
-      # APK unless you manually configure a keystore + signingConfig — Android
-      # refuses to install it with "App not installed". EAS handles signing
-      # automatically, keeps the SAME signing key across builds (so updates
-      # install cleanly), and outputs a proper installable release APK.
+      # Build with EAS CLOUD build (signed, installable release APK).
       - name: Build APK via EAS (signed release)
         id: eas-build
         env:
@@ -60,40 +39,49 @@ jobs:
         run: |
           npx eas-cli build -p android --profile preview --non-interactive \
             --message "Release ${{ github.ref_name }}"
-          # The EAS build runs on Expo's servers. Fetch the artifact URL from
-          # the most recent build for this profile.
-          BUILD_URL=$(npx eas-cli build:list --platform android --profile preview --limit 1 --non-interactive --json | \
-            python3 -c "import sys,json; d=json.load(sys.stdin); print([b['artifacts']['buildUrl'] for b in d if b.get('status')=='finished'][0])")
-          echo "Downloading APK from $BUILD_URL"
-          curl -L -o apk-release.apk "$BUILD_URL"
+          # Fetch the APK download URL from the most recent finished build.
+          npx eas-cli build:list --platform android --profile preview --limit 5 --non-interactive --json > /tmp/builds.json
+          python3 - <<'PY'
+          import json
+          builds = json.load(open('/tmp/builds.json'))
+          url = None
+          for b in builds:
+              status = (b.get('status') or '').lower()
+              art = b.get('artifacts') or {}
+              if status in ('finished', 'completed') and (art.get('buildUrl') or art.get('url')):
+                  url = art.get('buildUrl') or art.get('url')
+                  break
+          if not url:
+              for b in builds:
+                  art = b.get('artifacts') or {}
+                  if art.get('buildUrl'):
+                      url = art['buildUrl']; break
+          if not url:
+              raise SystemExit('could not find APK buildUrl; builds=' + json.dumps(builds)[:1500])
+          open('/tmp/apk_url.txt','w').write(url)
+          print('APK URL:', url)
+          PY
+          BUILD_URL=$(cat /tmp/apk_url.txt)
+          # Save the APK at the REPO ROOT (release upload runs from repo root,
+          # not the mobile/ working dir).
+          curl -L -o ../apk-release.apk "$BUILD_URL"
           echo "apk_path=apk-release.apk" >> "$GITHUB_OUTPUT"
 
       # Upload the EAS-built (signed) APK to GitHub Releases.
       - name: Upload APK to GitHub Release
-        if: startsWith(github.ref, 'refs/tags/') && steps.eas-build.outputs.apk_path != ''
+        if: startsWith(github.ref, 'refs/tags/')
         uses: softprops/action-gh-release@v2
         with:
           tag_name: ${{ github.ref_name }}
-          files: ${{ steps.eas-build.outputs.apk_path }}
+          files: apk-release.apk
           generate_release_notes: true
 
-      # Optional: upload to object storage (Cloudflare R2 / AWS S3).
-      - name: Upload APK to R2/S3
-        if: steps.eas-build.outputs.apk_path != '' && env.R2_ACCESS_KEY_ID != ''
-        env:
-          R2_ACCESS_KEY_ID: ${{ secrets.R2_ACCESS_KEY_ID }}
-          R2_SECRET_ACCESS_KEY: ${{ secrets.R2_SECRET_ACCESS_KEY }}
-          R2_ACCOUNT_ID: ${{ secrets.R2_ACCOUNT_ID }}
-          R2_BUCKET: ${{ secrets.R2_BUCKET }}
-        run: |
-          export AWS_ACCESS_KEY_ID="$R2_ACCESS_KEY_ID"
-          export AWS_SECRET_ACCESS_KEY="$R2_SECRET_ACCESS_KEY"
-          export AWS_ENDPOINT_URL="https://$R2_ACCOUNT_ID.r2.cloudflarestorage.com"
-          aws s3 cp "${{ steps.eas-build.outputs.apk_path }}" "s3://$R2_BUCKET/nuvora-app.apk" --endpoint-url "$AWS_ENDPOINT_URL" || echo "R2 upload skipped"
-
-      # Publish OTA update so installed apps get this build's JS (no reinstall).
+      # Publish OTA update (no reinstall for JS changes).
       - name: Publish OTA update
+        if: success()
         env:
           EXPO_TOKEN: ${{ secrets.EXPO_TOKEN }}
-        run: npx eas-cli update --channel preview --message "Release ${{ github.ref_name }}" --non-interactive || echo "OTA update skipped"
-
+          CI: "1"
+        run: |
+          npx eas-cli update --channel preview --message "Release ${{ github.ref_name }}" \
+            || echo "OTA update skipped"
