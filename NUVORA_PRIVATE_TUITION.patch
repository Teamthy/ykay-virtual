+	}
+	defer uow.Rollback()
+	req, err := uow.PrivateRequests().GetByID(ctx, requestID)
+	if err != nil {
+		return nil, err
+	}
+	if !isAdmin && req.ParentUserID != actorUserID {
+		return nil, domain.ErrForbidden
+	}
+	return req, nil
+}
