          "instant": false,
          "range": true
        },
        {
          "refId": "6A",
          "expr": "sum by (type) (rate(ykv_jobs_completed_total[10m]))",
          "legendFormat": "ok {{type}}",
          "instant": false,
          "range": true
        }
      ]
