# YK-Virtual on OCI â€” production environment
# Copy to /opt/ykay/virtual/.env on the server (chmod 600), fill every value.
# The Go API refuses to boot in ENVIRONMENT=production with dev/test values.
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

# Image released by GitHub Actions (set automatically by deploy.sh normally).
IMAGE_TAG=latest
GHCR_REPO=teamthy/ykay-virtual

# Public hostname Caddy terminates TLS for.
API_HOST=api.virtual.ykaycollege.com

# Postgres (container-internal; change the password!)
POSTGRES_DB=ykvirtual
POSTGRES_USER=ykvirtual
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# The Vercel-hosted web origin (used in emails/callbacks) and the exact
# browser origins allowed to call this API cross-origin (CORS is fail-closed).
SITE_URL=https://virtual.ykaycollege.com
ALLOWED_ORIGINS=https://virtual.ykaycollege.com

# Payments â€” LIVE keys in production. Refunds stay OFF until the refund drill
# (run in staging first; see runbook), then set true.
PAYMENT_PROVIDER=PAYSTACK
PAYSTACK_SECRET=sk_live_CHANGE_ME
FLUTTERWAVE_SECRET=
PAYMENT_REFUNDS_ENABLED=false

# Meetings â€” the API fatals in production when this is left as the stub.
MEETING_PROVIDER=jitsi
WHEREBY_API_KEY=

# Email / SMS / WhatsApp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=YK-Virtual <no-reply@ykaycollege.com>
TERMII_API_KEY=
TERMII_SENDER_ID=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI support assistant
GEMINI_API_KEY=
CHATBOT_ENABLED=true
AI_MAX_TOKENS_PER_REQUEST=1024
AI_DAILY_BUDGET_TOKENS=200000

# Object storage (R2/S3-compatible) â€” buckets should be PRIVATE; signed URLs.
S3_ENDPOINT=https://CHANGE_ME.r2.cloudflarestorage.com
S3_PUBLIC_BUCKET=yk-virtual-public
S3_PRIVATE_BUCKET=yk-virtual-private
S3_QUARANTINE_BUCKET=yk-virtual-quarantine
S3_REGION=auto
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
STORAGE_MAX_UPLOAD_BYTES=10485760

# Bearer token guarding GET /metrics (Prometheus scrapes with this).
METRICS_TOKEN=CHANGE_ME_32plus_random_token

# Two independent 32+ char secrets (openssl rand -hex 32 each):
#  - CBT_ATTEMPT_SECRET signs practice/CBT attempt tokens
#  - COLLEGE_SSO_SECRET MUST equal the EduPortal COLLEGE_SSO_SECRET value
#    (federated login with the College portal).
CBT_ATTEMPT_SECRET=CHANGE_ME_32_chars_minimum_xxxxxxxxxxxx
COLLEGE_API_URL=https://ykaycollege.edu.ng
COLLEGE_SSO_SECRET=CHANGE_ME_shared_with_college_32plus

# OTA/expo (optional)
EXPO_ACCESS_TOKEN=

# Tracing (optional; leave blank to disable)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Backups
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_HOURS=24
