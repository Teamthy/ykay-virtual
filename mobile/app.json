{
  "expo": {
    "name": "YK-Virtual",
    "slug": "ykvirtual",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "ykvirtual",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#013920",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ykvirtual.app",
      "infoPlist": {
        "NSCameraUsageDescription": "YK-Virtual uses the camera for document uploads during tutor vetting.",
        "NSPhotoLibraryUsageDescription": "YK-Virtual lets you attach photos to assignments and support chats."
      }
    },
    "android": {
      "package": "com.ykvirtual.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#013920"
      },
      "permissions": ["INTERNET", "CAMERA", "READ_MEDIA_IMAGES"]
    },
    "web": {
      "bundler": "metro",
      "name": "YK-Virtual"
    },
    "updates": {
      "url": "https://u.expo.dev/9b9f036a-4492-4726-a6af-389b5e2d8d6b",
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "extra": {
      "projectId": "yk-virtual-prod",
      "eas": {
        "projectId": "9b9f036a-4492-4726-a6af-389b5e2d8d6b"
      }
    }
  }
}
