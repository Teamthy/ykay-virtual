{
  "expo": {
    "name": "NUVORA",
    "slug": "nuvora",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "nuvora",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#FFFCF5",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nuvora.app",
      "infoPlist": {
        "NSCameraUsageDescription": "NUVORA uses the camera for document uploads during tutor vetting.",
        "NSPhotoLibraryUsageDescription": "NUVORA lets you attach photos to assignments and support chats."
      }
    },
    "android": {
      "package": "com.nuvora.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A1F44"
      },
      "permissions": [
        "INTERNET",
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "name": "NUVORA"
    },
    "extra": {
      "apiUrl": "https://ykay-virtual.onrender.com/api/v1",
      "projectId": "nuvora-prod",
      "eas": {
        "projectId": "9b9f036a-4492-4726-a6af-389b5e2d8d6b"
      }
    }
  }
}
