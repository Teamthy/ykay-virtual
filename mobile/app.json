{
  "expo": {
    "name": "NUVORA",
    "slug": "nuvora",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "nuvora",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#013920",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nuvora.app",
      "infoPlist": {
        "NSCameraUsageDescription": "NUVORA uses the camera for document uploads during tutor vetting.",
        "NSPhotoLibraryUsageDescription": "NUVORA lets you attach photos to assignments and support chats."
      }
    },
    "android": {
      "package": "com.nuvora.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#013920"
      },
      "permissions": [
        "INTERNET",
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "name": "NUVORA"
    },
    "updates": {
      "url": "https://u.expo.dev/9b9f036a-4492-4726-a6af-389b5e2d8d6b",
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "extra": {
      "projectId": "nuvora-prod",
      "eas": {
        "projectId": "9b9f036a-4492-4726-a6af-389b5e2d8d6b"
      }
    }
  }
}
