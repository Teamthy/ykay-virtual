{
    "name": "ykay-virtual",
    "version": "0.3.0",
    "private": true,
    "scripts": {
        "dev:web": "npm --prefix client run dev",
        "dev:api": "go run ./cmd/api",
        "dev:worker": "go run ./cmd/worker",
        "migrate": "go run ./cmd/migrate --cmd=up",
        "build:web": "npm --prefix client run build",
        "typecheck": "npm --prefix client exec tsc -- --noEmit",
        "test:web": "npm --prefix client run test",
        "test:api": "go test ./...",
        "test": "go test ./...",
        "lighthouse": "lhci autorun --config=./lighthouserc.json"
    },
    "devDependencies": {}
}
