diff --git a/scripts/e2e.sh b/scripts/e2e.sh
index 61cc277..cd7aec8 100755
--- a/scripts/e2e.sh
+++ b/scripts/e2e.sh
@@ -44,8 +44,19 @@ BIN="${ROOT}/.e2e-api"
 # carry state from previous runs (409s, cached sessions) and poison results.
 if curl -sf -m 2 "http://localhost:${PORT}/health" >/dev/null 2>&1; then
   echo "Stale API on :${PORT} — killing for a fresh run"
-  pkill -f "$BIN" 2>/dev/null || true
-  sleep 1
+  # Kill by PORT, robustly. `pkill -f "$BIN"` (absolute path) fails to match a
+  # process launched as `./.e2e-api` (or any other binary) that happens to be
+  # squatting on the port — the stale server stays alive, the fresh memory API
+  # fails to bind, and the suite silently runs against the OLD server (e.g. a
+  # postgres-mode API with no seeded admin → every /admin/* call 401s). Kill
+  # whatever holds the port regardless of binary name/path.
+  if command -v fuser >/dev/null 2>&1; then
+    fuser -k "${PORT}/tcp" 2>/dev/null || true
+  else
+    pkill -f "[.]e2e-api" 2>/dev/null || true   # matches `./.e2e-api` (and dev variants)
+    pkill -f "$BIN" 2>/dev/null || true
+  fi
+  sleep 2
 fi
 trap 'kill $API_PID 2>/dev/null || true' EXIT
 echo "Starting API on :${PORT} (in-memory mode)…"
